{
    "name": "custom/ai-commerce-assistant",
    "description": "AICA - AI Commerce Assistant for Shopware 6 storefront",
    "type": "shopware-platform-plugin",
    "version": "2.0.0",
    "license": "MIT",
    "require": {
        "php": ">=8.2 <8.5",
        "shopware/core": "~6.7.0",
        "shopware/storefront": "~6.7.0",
        "shopware/administration": "~6.7.0"
    },
    "extra": {
        "shopware-plugin-class": "AiCommerceAssistant\\AiCommerceAssistant",
        "label": {
            "de-DE": "AICA - AI Commerce Assistant",
            "en-GB": "AICA - AI Commerce Assistant"
        }
    },
    "autoload": {
        "psr-4": {
            "AiCommerceAssistant\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AiCommerceAssistant\\Tests\\": "tests/"
        }
    }
}
